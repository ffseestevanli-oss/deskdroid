#!/bin/sh
# Starts the desktop session as the deskdroid user. Launched by deskdroid-boot.
# DESKDROID_GPU: llvmpipe | nocomp | turnip | venus
# DESKDROID_SCALE: Plasma scale factor from the screen's density (1, 1.25, ... 2)

export XDG_RUNTIME_DIR=/tmp/runtime-$USER
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=KDE KDE_FULL_SESSION=true
export QT_QPA_PLATFORM=xcb
# Plasma's systemd boot can't work under proot; the rootfs ships ~/.config/startkderc with systemdBoot=false.

case "${DESKDROID_GPU:-llvmpipe}" in
  llvmpipe)
    export GALLIUM_DRIVER=llvmpipe ;;
  nocomp)
    export GALLIUM_DRIVER=llvmpipe KWIN_COMPOSE=N ;;
  turnip)
    # Mesa with Turnip's kgsl backend from the deskdroid-mesa package.
    if [ -d /opt/deskdroid-mesa/lib ]; then
      export LD_LIBRARY_PATH=/opt/deskdroid-mesa/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
      export VK_ICD_FILENAMES=/opt/deskdroid-mesa/share/vulkan/icd.d/freedreno_icd.aarch64.json
      export LIBGL_DRIVERS_PATH=/opt/deskdroid-mesa/lib/dri
    fi
    export MESA_LOADER_DRIVER_OVERRIDE=zink TU_DEBUG=noconform ;;
  venus)
    # Mesa's Venus driver talks to the app's Venus server on /tmp/.virgl_test,
    # which runs Vulkan on Android's GPU driver; OpenGL goes through Zink. The
    # app writes the variables to a Plasma env file (VenusServer.kt), which
    # startplasma sources; reading it here too puts them in glxinfo's log line.
    # The app falls back to llvmpipe when the server won't start; this covers a socket that vanished.
    env=$HOME/.config/plasma-workspace/env/deskdroid-gpu.sh
    if [ -S /tmp/.virgl_test ] && [ -f "$env" ]; then
      . "$env"
    else
      echo "deskdroid-session: no Venus server socket, using llvmpipe"
      DESKDROID_GPU=llvmpipe
      rm -f "$env"
      export GALLIUM_DRIVER=llvmpipe
    fi ;;
esac

echo "deskdroid-session: GPU mode ${DESKDROID_GPU}, scale ${DESKDROID_SCALE:-1}"
glxinfo -B 2>&1 | grep -E 'renderer|version' || true

# Sound: PulseAudio writes into the FIFO the app plays from (/etc/deskdroid/pulse.pa).
if command -v pulseaudio >/dev/null; then
  pulseaudio --daemonize=yes --exit-idle-time=-1 --disallow-exit -n -F /etc/deskdroid/pulse.pa \
    || echo "deskdroid-session: pulseaudio failed"
fi

# Scale: Qt/KDE read the X DPI, GTK takes an integer scale.
SCALE="${DESKDROID_SCALE:-1}"
DPI=$(awk -v s="$SCALE" 'BEGIN { printf "%d", 96 * s }')
echo "Xft.dpi: $DPI" | xrdb -merge
if command -v kwriteconfig6 >/dev/null; then
  kwriteconfig6 --file kcmfonts --group General --key forceFontDPI "$DPI"
  kwriteconfig6 --file kdeglobals --group KScreen --key ScaleFactor "$SCALE"
fi
export GDK_SCALE=$(awk -v s="$SCALE" 'BEGIN { printf "%d", (s >= 1.75) ? 2 : 1 }')
# GTK already sizes text from Xft.dpi, which carries the whole scale; GDK_SCALE
# would double that, so GDK_DPI_SCALE takes it back out.
export GDK_DPI_SCALE=$(awk -v g="$GDK_SCALE" 'BEGIN { printf "%.2f", 1 / g }')

# Gecko browsers (Floorp): their sandboxes need seccomp and user namespaces,
# which proot can't provide, so tabs crash without these.
export MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 \
  MOZ_DISABLE_RDD_SANDBOX=1 MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 \
  MOZ_DISABLE_UTILITY_SANDBOX=1

# Light/Full run Plasma; Ultra-lite runs MATE.
if command -v startplasma-x11 >/dev/null; then
  exec dbus-launch --exit-with-session startplasma-x11
else
  export XDG_CURRENT_DESKTOP=MATE
  exec dbus-launch --exit-with-session mate-session
fi
