#!/bin/sh
# kwin_wayland for the experimental Wayland session, nested in Termux:X11.
# kwin_wayland_wrapper runs it (through /usr/local/lib/deskdroid/wayland) with
# its socket arguments; this adds KWin's X11 backend options so the output
# window fills the X screen at the desktop scale (KWin's default is 1024x768).
# DESKDROID_X11_DISPLAY and DESKDROID_SCALE come from deskdroid-session.

d="${DESKDROID_X11_DISPLAY:-:0}"
s="${DESKDROID_SCALE:-1}"
# --width/--height are logical; KWin multiplies them by the scale.
size=$(DISPLAY="$d" xwininfo -root 2>/dev/null | awk -v s="$s" '
  /Width:/ { w = $2 } /Height:/ { h = $2 }
  END { if (w > 0 && h > 0) printf "--width %d --height %d", w / s + 0.5, h / s + 0.5 }')
[ -n "$size" ] || echo "deskdroid-kwin-wayland: no X screen size on $d, using KWin's default"

# Termux:X11 resizes its screen when the phone rotates or a monitor is plugged
# in, but no window manager runs there to resize KWin's window with it. Check
# the screen size every second and resize the window to match; KWin then
# resizes its output and Plasma follows. (Polling: RandR events didn't arrive
# on the phone.) The window is found by KWin's _NET_WM_PID, which is ours
# after exec, or by its title; failing both, every large top-level window,
# since in this session only KWin draws on Termux:X11 (X11 apps use Xwayland).
kwin=$$
# KWin applies that resize as a bare mode change, which skips its usual
# display-change path: Plasma keeps the panel where it was and KWin keeps the
# old maximize area. A real output configuration change (here: the scale,
# nudged and set back through kscreen-doctor) makes both lay out again. It
# also applies the desktop scale, which KWin's saved output config overrides.
wl_socket=wayland-0
prev=
for arg in "$@"; do
  [ "$prev" = --socket ] && wl_socket=$arg
  prev=$arg
done
relayout() {
  command -v kscreen-doctor >/dev/null || return
  ksd() { WAYLAND_DISPLAY="$wl_socket" kscreen-doctor "$@" 2>/dev/null; }
  out=$(ksd -o | sed 's/\x1b\[[0-9;]*m//g' | awk '/^Output:/ { print $3; exit }')
  [ -n "$out" ] || { echo "deskdroid-kwin-wayland: kscreen-doctor found no output"; return; }
  ksd "output.$out.scale.$(awk -v s="$s" 'BEGIN { print s + 0.05 }')" >/dev/null
  sleep 1
  ksd "output.$out.scale.$s" >/dev/null
}
kwin_windows() {
  { DISPLAY="$d" xdotool search --pid "$kwin"
    DISPLAY="$d" xdotool search --name '^KDE Wayland Compositor'; } 2>/dev/null | sort -u | grep . && return
  DISPLAY="$d" xwininfo -root -children 2>/dev/null | awk '$1 ~ /^0x/ {
    for (i = 2; i <= NF; i++) if (split($i, g, /[x+-]/) >= 2 && g[1] >= 200 && g[2] >= 200) { print $1; break } }'
}
follow_screen() {
  done_size= tries=0
  while sleep 1 && kill -0 "$kwin" 2>/dev/null; do
    size=$(DISPLAY="$d" xwininfo -root 2>/dev/null | awk '/Width:/ { w = $2 } /Height:/ { h = $2 } END { if (w > 0 && h > 0) print w, h }')
    [ -n "$size" ] && [ "$size" != "$done_size" ] || continue
    wins=$(kwin_windows)
    if [ -z "$wins" ]; then
      # KWin's window may not be up yet; say once if it never shows.
      tries=$((tries + 1))
      if [ "$tries" = 15 ]; then
        echo "deskdroid-kwin-wayland: no KWin window on $d to resize; top-level windows:"
        DISPLAY="$d" xwininfo -root -children 2>&1 | sed 's/^/  /'
      fi
      continue
    fi
    for win in $wins; do
      # shellcheck disable=SC2086 # width and height
      DISPLAY="$d" xdotool windowsize "$win" $size || echo "deskdroid-kwin-wayland: resizing $win failed"
    done
    echo "deskdroid-kwin-wayland: screen $size, sized KWin's window" $wins
    done_size=$size tries=0
    sleep 1
    relayout
  done
}
if command -v xdotool >/dev/null; then
  follow_screen &
else
  echo "deskdroid-kwin-wayland: xdotool missing, the desktop won't follow rotation"
fi

echo "deskdroid-kwin-wayland: starting KWin on $d, $size, scale $s"
# shellcheck disable=SC2086 # $size is two option pairs
exec /usr/bin/kwin_wayland --x11-display "$d" $size --scale "$s" "$@"
