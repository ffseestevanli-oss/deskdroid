#!/bin/bash
# Installed by the DeskDroid app (Steam.kt) at every session start; the
# Steam menu entry runs it. Starts Valve's native ARM64 Steam client.
#   deskdroid-steam [STEAM ARGS]  installs on first use, then starts Steam
#   deskdroid-steam --reinstall   downloads Valve's ARM64 client seed again
# The first start installs the libraries Steam needs and Valve's ARM64 client
# seed (about 110 MB) in a Konsole window so progress shows; Steam then
# downloads and updates the rest of itself and shows Valve's license.
# Log: ~/.local/share/deskdroid-steam/steam.log
#
# The client runs directly, not through steam.sh: steam.sh refuses to start
# without user namespaces (for its pressure-vessel containers), which proot
# can't provide. x86 programs still go through deskdroid-fex.

STEAMDIR=$HOME/.local/share/Steam
STATE=$HOME/.local/share/deskdroid-steam
LOG=$STATE/steam.log
CDN=https://client-update.steamstatic.com
MANIFEST=$CDN/steam_client_linuxarm64
SEED_PACKAGE=bins_linuxarm64_linuxarm64
# Used when the manifest can't be read: a seed known to work under proot.
PINNED_SEED=bins_linuxarm64_linuxarm64.zip.4f25204460fd1f27acce2f687019e2518ed8d8bf
PINNED_SHA256=3f282edba1e24ab01c4d532a43bf3000946df8199c16f16c279635f16c6edc06
# Debian libraries the ARM64 client and its web helper load.
PACKAGES="ca-certificates curl unzip dbus-x11 fonts-dejavu-core libasound2t64 libavcodec61
libavutil59 libegl1 libgl1 libgtk-3-0t64 libgtk2.0-0t64 libibus-1.0-5 libnm0 libnss-mdns
libnss3 libopenal1 libpipewire-0.3-0t64 libpulse0 libsdl2-2.0-0 libva2 libvdpau1 libxss1
procps x11-utils"
# steamwebhelper (Chromium) can't use its sandbox under proot, and draws
# better in software than through llvmpipe. -chromeosnopreallocate and
# -noverifyfiles skip file work that is very slow under ptrace.
STEAM_ARGS="-no-cef-sandbox -cef-disable-gpu -chromeosnopreallocate -noverifyfiles"

say() { echo "deskdroid-steam: $*" >&2; }
die() { say "$*"; exit 1; }

installed() {
  [ -x "$STEAMDIR/steamrtarm64/steam" ] && [ -f "$STATE/packages-done" ]
}

install_packages() {
  [ -f "$STATE/packages-done" ] && return 0
  local missing="" p
  for p in $PACKAGES; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "ok installed" || missing="$missing $p"
  done
  if [ -n "$missing" ]; then
    say "installing the libraries Steam needs:$missing"
    sudo apt-get update -q || die "couldn't update the package lists (offline?)"
    # shellcheck disable=SC2086
    sudo apt-get install -y -q --no-install-recommends $missing || die "couldn't install$missing"
  fi
  touch "$STATE/packages-done"
}

# A field of a package block in Valve's VDF manifest, e.g. "file" or "sha2".
manifest_field() {
  awk -v pkg="\"$2\"" -v key="\"$3\"" '
    $1 == pkg { found = 1; next }
    found && $1 == "}" { exit }
    found && $1 == key { gsub(/"/, "", $2); print $2; exit }
  ' "$1"
}

# Valve's ARM64 client seed: the native steam binary, which downloads the rest.
install_seed() {
  [ -x "$STEAMDIR/steamrtarm64/steam" ] && [ "${1:-}" != force ] && return 0
  local tmp file sha
  tmp=$(mktemp -d) || die "no temporary folder"
  say "downloading Valve's ARM64 Steam client"
  if curl -fsSL --retry 3 -o "$tmp/manifest" "$MANIFEST"; then
    file=$(manifest_field "$tmp/manifest" "$SEED_PACKAGE" file)
    sha=$(manifest_field "$tmp/manifest" "$SEED_PACKAGE" sha2)
  fi
  if [ -z "$file" ]; then
    say "couldn't read Valve's manifest, using the known-good seed"
    file=$PINNED_SEED sha=$PINNED_SHA256
  fi
  curl -fL --retry 3 -o "$tmp/seed.zip" "$CDN/$file" || { rm -rf "$tmp"; die "couldn't download Steam (offline?)"; }
  # The manifest's sha2 is the zip's SHA-256 as far as we know; a mismatch is
  # logged, and the zip's own checksums decide.
  if [ -n "$sha" ] && [ "$(sha256sum "$tmp/seed.zip" | cut -d' ' -f1)" != "$sha" ]; then
    say "note: the download doesn't match the manifest's sha2, checking the zip itself"
  fi
  unzip -tqq "$tmp/seed.zip" >/dev/null || { rm -rf "$tmp"; die "the Steam download is damaged, try again"; }
  mkdir -p "$STEAMDIR"
  unzip -oqq "$tmp/seed.zip" -d "$STEAMDIR" || { rm -rf "$tmp"; die "couldn't unpack Steam"; }
  rm -rf "$tmp"
  [ -x "$STEAMDIR/steamrtarm64/steam" ] || chmod +x "$STEAMDIR/steamrtarm64/steam" 2>/dev/null
  [ -x "$STEAMDIR/steamrtarm64/steam" ] || die "no steamrtarm64/steam in Valve's download"
  say "Steam ARM64 client installed in $STEAMDIR"
}

# The $HOME/.steam layout the client expects (what steam.sh would set up).
link_dirs() {
  mkdir -p "$HOME/.steam"
  ln -sfn "$STEAMDIR" "$HOME/.steam/steam"
  ln -sfn "$STEAMDIR" "$HOME/.steam/root"
  ln -sfn "$STEAMDIR/linuxarm64" "$HOME/.steam/sdkarm64"
  ln -sfn "$STEAMDIR/steamrtarm64" "$HOME/.steam/steamrtarm64"
  ln -sfn "$STEAMDIR/steamrt64" "$HOME/.steam/bin64"
  ln -sfn "$STEAMDIR/steamrt32" "$HOME/.steam/bin32"
}

run_steam() {
  local extra=""
  [ -f "$HOME/.config/deskdroid-steam-args" ] && extra=$(head -n 1 "$HOME/.config/deskdroid-steam-args")
  link_dirs
  echo "=== $(date) deskdroid-steam: $(uname -srm), ARM64 client" >>"$LOG"
  cd "$STEAMDIR" || die "no $STEAMDIR"
  # shellcheck disable=SC2086
  exec "$STEAMDIR/steamrtarm64/steam" $STEAM_ARGS $extra "$@" >>"$LOG" 2>&1
}

mkdir -p "$STATE"

case "${1:-}" in
  -h | --help)
    sed -n '5,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  --reinstall)
    shift
    install_seed force || exit 1 ;;
  --setup)
    # In the Konsole window from the menu launch below.
    shift
    if install_packages && install_seed; then
      echo
      say "done, starting Steam (it updates itself first, which takes a while)"
      setsid "$0" "$@" </dev/null >/dev/null 2>&1 &
      sleep 5
      exit 0
    fi
    echo
    say "setup failed. Start Steam again to retry. Press Enter to close."
    read -r _
    exit 1 ;;
esac

if ! installed; then
  if [ -t 1 ]; then
    install_packages && install_seed || exit 1
  else
    exec konsole --hide-menubar -p tabtitle="Setting up Steam" -e "$0" --setup "$@"
  fi
fi
run_steam "$@"
