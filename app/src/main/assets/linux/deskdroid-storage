#!/bin/sh
# Installed by the DeskDroid app (Storage.kt) at every session start. Runs as
# root in the background while the desktop starts. When the phone's storage is
# shared (DESKDROID_STORAGE is its path), adds "Phone" and "Camera" to the
# Places panel of Dolphin and the file dialogs. KDE writes its default places
# the first time it needs them, so wait for that file instead of writing one
# (a file without the defaults would leave Home, Trash and the rest out).

PHONE="$DESKDROID_STORAGE"
[ -n "$PHONE" ] && [ -d "$PHONE" ] || exit 0
XBEL=/home/deskdroid/.local/share/user-places.xbel

i=0
while [ ! -s "$XBEL" ]; do
  [ "$i" -lt 600 ] || exit 0
  sleep 1
  i=$((i + 1))
done
sleep 2 # let KDE finish writing it

place() { # href title icon id
  grep -q "href=\"$1\"" "$XBEL" && return
  cat <<XML
 <bookmark href="$1">
  <title>$2</title>
  <info>
   <metadata owner="http://freedesktop.org">
    <bookmark:icon name="$3"/>
   </metadata>
   <metadata owner="http://www.kde.org">
    <ID>$4</ID>
   </metadata>
  </info>
 </bookmark>
XML
}

ADD=/tmp/deskdroid-places.$$
{
  place "file://$PHONE" Phone smartphone "deskdroid/phone"
  [ -d "$PHONE/DCIM" ] && place "file://$PHONE/DCIM" Camera camera-photo "deskdroid/camera"
} > "$ADD"
if [ -s "$ADD" ] && grep -q '</xbel>' "$XBEL"; then
  awk -v add="$ADD" '/<\/xbel>/ { while ((getline l < add) > 0) print l } { print }' "$XBEL" > "$ADD.new" \
    && cat "$ADD.new" > "$XBEL" && echo "deskdroid-storage: added phone storage to Places"
fi
rm -f "$ADD" "$ADD.new"
exit 0
