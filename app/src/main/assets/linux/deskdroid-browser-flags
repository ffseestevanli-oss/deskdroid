#!/bin/sh
# Installed by the DeskDroid app (Browsers.kt) at every session start. Runs as
# root before the desktop starts and after every apt/dpkg run.
#
# Chromium-based browsers (Chromium, Chrome, Brave, Vivaldi, Edge, ...) and
# Electron apps abort at launch under proot: their sandbox needs user
# namespaces, which proot only pretends to create. They work with --no-sandbox,
# so for each one this writes:
# - a copy of its .desktop file with --no-sandbox into /usr/local/share/applications,
#   which shadows /usr/share/applications (menus, default browser, xdg-open)
# - a same-named wrapper in /usr/local/bin for launches from a terminal
# - /etc/chromium.d/deskdroid for Debian's chromium script
# Files it wrote before are removed first, so uninstalled apps leave nothing behind.
#
# The scan starts several programs per installed app, and every program start
# is slow under proot, so at session start (--if-changed) it is skipped when
# neither the app list nor this script changed since the last full run. apt
# runs it without the flag after every install.

APPS=/usr/local/share/applications
BIN=/usr/local/bin
MARK="generated by deskdroid-browser-flags"
STAMP=/var/lib/deskdroid/browser-flags.done
# Without /usr/local/bin, so lookups find the real program, not our wrapper.
PATH=/usr/sbin:/usr/bin:/sbin:/bin

if [ "$1" = --if-changed ] && [ -e "$STAMP" ] \
    && [ "$STAMP" -nt /usr/share/applications ] && [ "$STAMP" -nt "$0" ]; then
  exit 0
fi

mkdir -p "$APPS" "$BIN"
for f in "$APPS"/*.desktop "$BIN"/*; do
  [ -f "$f" ] && head -n 3 "$f" | grep -q "$MARK" && rm -f "$f"
done

if [ -d /etc/chromium.d ]; then
  printf '# %s: Chromium needs --no-sandbox under proot.\nexport CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox"\n' \
    "$MARK" > /etc/chromium.d/deskdroid
fi

# True if $1 (a path or a command name) is a Chromium-based browser or an Electron app.
is_chromium() {
  p=$(command -v "$1" 2>/dev/null) || return 1
  case "${p##*/}" in
    chromium|chromium-browser|google-chrome*|brave-browser*|vivaldi*|microsoft-edge*|opera*|thorium-browser*|ungoogled-chromium*)
      return 0 ;;
  esac
  d=$(dirname "$(readlink -f "$p")")
  [ -e "$d/chrome-sandbox" ] || [ -e "$d/chrome_crashpad_handler" ]
}

for desktop in /usr/share/applications/*.desktop; do
  [ -f "$desktop" ] || continue
  name=${desktop##*/}
  [ -e "$APPS/$name" ] && continue # the admin's own override wins
  exe=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$desktop" | head -n 1)
  [ -n "$exe" ] && is_chromium "$exe" || continue
  grep -q '^Exec=.*--no-sandbox' "$desktop" && continue

  # --no-sandbox goes right after the program on every Exec line that runs it
  # (the main one and the actions, e.g. "New Incognito Window").
  awk -v exe="$exe" -v mark="$MARK" '
    NR == 1 { print "# " mark }
    /^Exec=/ {
      cmd = substr($0, 6)
      if (cmd == exe || index(cmd, exe " ") == 1) {
        print "Exec=" exe " --no-sandbox" substr(cmd, length(exe) + 1)
        next
      }
    }
    { print }
  ' "$desktop" > "$APPS/$name.tmp" && mv "$APPS/$name.tmp" "$APPS/$name"

  prog=$(command -v "$exe")
  wrapper="$BIN/${prog##*/}"
  if [ "${prog%/*}" = /usr/bin ] && [ ! -e "$wrapper" ]; then
    printf '#!/bin/sh\n# %s: needs --no-sandbox under proot.\nexec %s --no-sandbox "$@"\n' \
      "$MARK" "$prog" > "$wrapper"
    chmod 755 "$wrapper"
  fi
done
mkdir -p "${STAMP%/*}" && touch "$STAMP"
exit 0
