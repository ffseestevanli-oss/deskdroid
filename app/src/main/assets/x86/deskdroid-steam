#!/system/bin/sh
# Steam (experimental) on DeskDroid's native desktop: Valve's x86 Steam client
# through FEX-Emu. Written into files/x86/bin by the app (X86.kt) at each
# desktop start; the "Steam (experimental)" menu entry runs it.
#   deskdroid-steam [STEAM ARGS]   sets up on first use, then starts Steam
#   deskdroid-steam --reinstall    downloads FEX and the x86 system again
# The first start opens the Steam Installation Assistant (steam-assistant,
# native/plasma/steamassistant), or a Konsole window without it: the app
# downloads FEX-Emu and the x86 system (about 1.2 GB, 4 GB unpacked), then
# Valve's Steam bootstrap.
#
# The assistant drives the rest through these (no window, output on stdout):
#   --status              fex=0|1, steam=0|1 (one per line)
#   --install             sets up FEX, the x86 system and Steam's bootstrap
#   --tool NAME           update | soft-reset | hard-reset | uninstall | purge
#   --check               runs one x86 program through FEX, at most 2 minutes
#   --stop                stops FEX and everything it started
#   --run-x86 FILE [ARGS] an x86-64 (or x86) Linux program through FEX
#   --run-windows FILE    a Windows program through Steam's Proton (or Wine)
#   --wine-tool NAME [PREFIX]  winecfg | uninstaller | explorer in a prefix
# Logs: files/x86/steam.log (Steam) and files/x86/install.log (setup).
#
# This half runs on Android's shell; steam-x86.sh is the x86 half, run by
# FEX's x86 bash from the x86 system.

X86=$(cd "$(dirname "$0")/.." && pwd)
FEX=$X86/fex/bin/FEXInterpreter
LOG=$X86/steam.log
STEAMDIR=$HOME/.local/share/Steam
export DESKDROID_X86="$X86" FEX_ROOTFS="$X86/rootfs" DDMASK_X86_64="$FEX" DDMASK_I386="$FEX"

# FEX-Emu's server (FEXServer): one socket at a known place, and a temporary
# folder that exists (Android has no /tmp; FEX falls back to it otherwise).
RUN=$X86/run
export FEX_SERVERSOCKETPATH="$RUN/FEXServer.Socket"
[ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ] || export TMPDIR="$RUN/tmp"

say() { echo "deskdroid-steam: $*"; }
ready() { [ -f "$X86/ready" ] && [ -e "$FEX" ]; }
steam_ready() { [ -f "$STEAMDIR/steam.sh" ]; }
x86() { fex_up && "$FEX" /bin/bash "$X86/bin/steam-x86.sh" "$@"; }

# Starts FEXServer here, before FEX runs anything. Left to FEX, the first x86
# program starts it and waits for it with no time limit, which is where the
# assistant stalled at 82% ("FEX-Emu is ready") when the server didn't come up.
fex_up() {
  mkdir -p "$RUN" "$TMPDIR"
  if pgrep -f "$X86/fex/bin/FEXServer" >/dev/null 2>&1 && [ -S "$FEX_SERVERSOCKETPATH" ]; then
    return 0
  fi
  pkill -f "$X86/fex/bin/FEXServer" 2>/dev/null
  rm -f "$FEX_SERVERSOCKETPATH"
  # -p: stays 10 minutes after the last x86 program, so Steam's restarts reuse it.
  # It goes to the background itself; its messages go to the setup log.
  "$X86/fex/bin/FEXServer" -p 600 </dev/null >>"$RUN/fexserver.log" 2>&1
  i=0
  while [ $i -lt 30 ]; do
    [ -S "$FEX_SERVERSOCKETPATH" ] && return 0
    sleep 1
    i=$((i + 1))
  done
  say "FEX-Emu's server didn't start in 30 seconds."
  [ -s "$RUN/fexserver.log" ] && tail -n 20 "$RUN/fexserver.log" | sed 's/^/  FEXServer: /'
  return 1
}

# Runs one x86 program before anything bigger, with a time limit, so a FEX
# that can't start says so instead of waiting forever.
fex_check() {
  say "checking FEX-Emu (an x86 program, at most 2 minutes)"
  fex_up || return 1
  out=$(timeout 120 "$FEX" /bin/uname -m 2>&1)
  status=$?
  if [ $status -eq 0 ] && [ "$(echo "$out" | tail -n 1)" = x86_64 ]; then
    say "FEX-Emu runs x86 programs ($out)"
    return 0
  fi
  [ $status -eq 124 ] && say "FEX-Emu didn't finish its first x86 program in 2 minutes." \
    || say "FEX-Emu couldn't run its first x86 program (exit $status)."
  [ -n "$out" ] && echo "$out" | tail -n 20 | sed 's/^/  FEX: /'
  [ -s "$RUN/fexserver.log" ] && tail -n 10 "$RUN/fexserver.log" | sed 's/^/  FEXServer: /'
  return 1
}

# Everything FEX started (the assistant's Cancel, or after a stall).
fex_stop() {
  pkill -f "$X86/bin/steam-x86.sh" 2>/dev/null
  pkill -f "$X86/fex/bin/" 2>/dev/null
  rm -f "$FEX_SERVERSOCKETPATH"
}

# Asks the app for FEX and the x86 system, and shows its progress.
install_x86() {
  rm -f "$X86/install.state"
  mkdir -p "$HOME/open-requests"
  t="$HOME/open-requests/.x86-$$"
  echo "deskdroid:x86-install" > "$t" && mv "$t" "$HOME/open-requests/x86-$$.req"
  shown=0 waited=0
  while :; do
    if [ -f "$X86/install.log" ]; then
      lines=$(wc -l < "$X86/install.log")
      [ "$lines" -gt "$shown" ] && tail -n +$((shown + 1)) "$X86/install.log" | head -n $((lines - shown))
      shown=$lines
    fi
    state=$(cat "$X86/install.state" 2>/dev/null)
    case "$state" in
      done*) return 0 ;;
      failed*) return 1 ;;
      "")
        waited=$((waited + 1))
        [ $waited -gt 15 ] && { say "DeskDroid didn't answer (is the desktop running?)"; return 1; } ;;
    esac
    sleep 2
  done
}

setup() {
  if ! ready || [ "${1:-}" = force ]; then
    say "Steam runs on x86 Linux. DeskDroid runs it with FEX-Emu, in an x86 system"
    say "(Ubuntu 24.04 for x86): about 1.2 GB to download and 4 GB on the phone."
    echo
    install_x86 || return 1
    echo
  fi
  if ! steam_ready; then
    fex_check || return 1
    x86 setup || return 1
  fi
}

# Steam's own data outside STEAMDIR: ~/.steam links and the login registry.
steam_tool() {
  case "$1" in
    update)
      # Steam downloads its client again at the next start (package/ holds
      # what it downloaded and which version it has).
      steam_ready || { say "Steam isn't installed"; return 1; }
      rm -rf "$STEAMDIR/package"
      say "Steam will download its client again the next time it starts" ;;
    soft-reset)
      # Sign-ins: saved accounts, their login tokens and Steam Guard files.
      rm -f "$STEAMDIR/config/loginusers.vdf" "$STEAMDIR"/ssfn* "$STEAMDIR/local.vdf" \
        "$HOME/.steam/registry.vdf" "$HOME/.steam/steam/registry.vdf"
      rm -rf "$STEAMDIR/config/htmlcache" "$HOME/.local/share/Steam/config/htmlcache"
      say "signed out: Steam asks for your account the next time it starts" ;;
    hard-reset)
      # Like steam.sh --reset: everything but the games (steamapps) and the
      # players' own data (userdata), then the bootstrap again.
      steam_ready || { say "Steam isn't installed"; return 1; }
      ready || { say "FEX-Emu isn't installed"; return 1; }
      x86 reset ;;
    uninstall)
      rm -rf "$STEAMDIR" "$HOME/.steam"
      say "Steam removed (FEX-Emu and the x86 system stay)" ;;
    purge)
      fex_stop
      rm -rf "$STEAMDIR" "$HOME/.steam" "$X86/fex" "$X86/rootfs" "$RUN" "$X86/fex.new" "$X86/rootfs.new" \
        "$X86/ready" "$X86/install.state" "$X86/install.log" "$HOME/.local/share/deskdroid-wine" \
        "$HOME/.config/deskdroid-steam-assistant.conf"
      say "Steam, FEX-Emu and the x86 system removed" ;;
    *) say "unknown tool: $1"; return 2 ;;
  esac
}

case "${1:-}" in
  -h | --help)
    sed -n '5,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  --status)
    if ready; then echo fex=1; else echo fex=0; fi
    if steam_ready; then echo steam=1; else echo steam=0; fi
    exit 0 ;;
  --install)
    shift
    setup || exit 1
    say "Steam is installed"
    exit 0 ;;
  --tool)
    steam_tool "${2:-}"
    exit ;;
  --stop)
    fex_stop
    exit 0 ;;
  --check)
    ready || { say "FEX-Emu isn't installed"; exit 1; }
    fex_check
    exit ;;
  --run-x86)
    shift
    ready || { say "FEX-Emu isn't installed (Steam Installation Assistant)"; exit 1; }
    [ -n "${1:-}" ] || { say "usage: deskdroid-steam --run-x86 FILE [ARGS]"; exit 2; }
    echo "=== $(date) deskdroid-steam: x86 program $1" >>"$X86/apps.log"
    x86 exec "$@" >>"$X86/apps.log" 2>&1
    exit ;;
  --run-windows | --wine-tool)
    mode=$1; shift
    ready || { say "FEX-Emu isn't installed (Steam Installation Assistant)"; exit 1; }
    [ -n "${1:-}" ] || { say "usage: deskdroid-steam $mode FILE|TOOL [PREFIX]"; exit 2; }
    echo "=== $(date) deskdroid-steam: Windows program $*" >>"$X86/apps.log"
    if [ "$mode" = --run-windows ]; then x86 wine "$@"; else x86 wine-tool "$@"; fi >>"$X86/apps.log" 2>&1
    exit ;;
  --reinstall)
    shift
    rm -f "$X86/ready"
    if [ -t 1 ]; then setup force; exit; fi
    exec konsole --hide-menubar -p tabtitle="Setting up Steam" -e "$0" --setup ;;
  --setup)
    # In the Konsole window from below.
    shift
    if setup; then
      echo
      say "done, starting Steam (it updates itself first, which takes a while)"
      # Out of Konsole's session, so closing the window doesn't end Steam.
      if command -v setsid >/dev/null; then setsid "$0" "$@" </dev/null >/dev/null 2>&1 &
      else nohup "$0" "$@" </dev/null >/dev/null 2>&1 &
      fi
      sleep 5
      exit 0
    fi
    echo
    say "setup failed (see above). Start Steam again to retry. Press Enter to close."
    read -r _
    exit 1 ;;
esac

if ! ready || ! steam_ready; then
  if [ -t 1 ]; then
    setup || exit 1
  elif command -v steam-assistant >/dev/null; then
    # The Steam Installation Assistant sets up and offers to start Steam.
    exec steam-assistant
  else
    exec konsole --hide-menubar -p tabtitle="Setting up Steam" -e "$0" --setup "$@"
  fi
fi
echo "=== $(date) deskdroid-steam: $(uname -srm), FEX $(cat "$X86/fex/share/deskdroid-fex/version" 2>/dev/null)" >>"$LOG"
x86 run "$@" >>"$LOG" 2>&1
