<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- glibc programs (ddmask): DNS servers for their resolv.conf. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Private Space's apps in the native desktop's menu: Android grants this to
      the home app, so only while DeskDroid is the phone's home screen.
    -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!-- The phone's apps in the native desktop's menu (NativeDesk.writeAndroidApps). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Phone storage shared with the desktop (Storage.kt): "All files access" on
      Android 11+, the storage permission (with legacy storage) on Android 10.
      DeskDroid ships on GitHub and F-Droid, so Play's All files access policy doesn't apply.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- lorie asks for this to change settings over ADB; DeskDroid never needs it. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" />

    <!--
      Native libs are extracted to nativeLibraryDir (useLegacyPackaging in
      app/build.gradle.kts) so proot and its helpers can be executed (W^X).
      The application class is lorie's LorieApp (merged from external/termux-x11).
    -->
    <application
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:replace="android:allowBackup">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The desktop window: lorie's MainActivity plus DeskDroid's drawer. -->
        <activity
            android:name=".DesktopActivity"
            android:exported="false"
            android:taskAffinity=".DesktopActivity"
            android:theme="@style/LorieAppTheme"
            android:launchMode="singleInstance"
            android:autoRemoveFromRecents="true"
            android:supportsPictureInPicture="false"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!--
          The native desktop (NativeDesk.kt), opened from Settings. It can also be
          the phone's home screen: pick DeskDroid in Android's Default apps, Home app.
        -->
        <activity
            android:name=".NativeDeskActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The desktop on a monitor (display out). As the home app's SECONDARY_HOME,
          Android opens it on a connected monitor instead of its own desktop mode.
          A monitor's home can't be single-task, hence its own activity.
        -->
        <activity
            android:name=".ExternalDeskActivity"
            android:exported="true"
            android:launchMode="standard"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The phone as touchpad and keyboard while the desktop is on a monitor. -->
        <activity
            android:name=".PhoneTouchpadActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- The app store (Store.kt), over the desktop. -->
        <activity
            android:name=".StoreActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Restart or Power Off on the desktop's logout screen: Android's power menu. -->
        <service
            android:name=".PowerMenuService"
            android:exported="false"
            android:label="@string/power_menu_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/power_menu_service" />
        </service>

        <!-- Termux:X11's own launcher entry and settings screen: hidden, DeskDroid has its own. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
        <activity
            android:name="com.termux.x11.LoriePreferences"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
        <!-- The X server (a child app_process with our uid) broadcasts to these; no other app needs to. -->
        <receiver
            android:name="com.termux.x11.LorieApp$Receiver"
            android:exported="false"
            tools:replace="android:exported" />
        <receiver
            android:name="com.termux.x11.LoriePreferences$Receiver"
            android:exported="false"
            tools:replace="android:exported" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".InstallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Downloads and unpacks the Linux desktop system image" />
        </service>

        <service
            android:name=".NativeDeskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's native Plasma desktop running while its window is in the background" />
        </service>

        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's Linux desktop session running" />
        </service>
        <!-- Files the native desktop opens with Android apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/open_paths" />
        </provider>
    </application>
</manifest>
