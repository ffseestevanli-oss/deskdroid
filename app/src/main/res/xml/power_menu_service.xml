<?xml version="1.0" encoding="utf-8"?>
<!--
  PowerMenuService, the DeskDroid desktop helper: global actions (power menu,
  Quick Settings for Exit DeX), which app owns each window on which display
  (MonitorGuard), and Meta / Alt+Tab while a DeskDroid window has the focus.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="200"
    android:description="@string/power_menu_service_description" />
