      "selected-text-color": "#F2F2F7"
    },
    "SpecialChar": {
      "text-color": "#7DFFB0",
      "selected-text-color": "#F2F2F7"
    },
    "String": {
      "text-color": "#3DFF8B",
      "selected-text-color": "#F2F2F7"
    },
    "VerbatimString": {
      "text-color": "#3DFF8B",
      "selected-text-color": "#F2F2F7"
    },
    "SpecialString": {
      "text-color": "#7DFFB0",
      "selected-text-color": "#F2F2F7"
    },
    "Import": {
      "text-color": "#8B5CFF",
      "selected-text-color": "#F2F2F7"
    },
    "DataType": {
      "text-color": "#FFE14D",
      "selected-text-color": "#F2F2F7"
    },
    "DecVal": {
      "text-color": "#FF9F1C",
      "selected-text-color": "#F2F2F7"
    },
    "BaseN": {
      "text-color": "#FF9F1C",
      "selected-text-color": "#F2F2F7"
    },
    "Float": {
      "text-color": "#FF9F1C",
      "selected-text-color": "#F2F2F7"
    },
    "Constant": {
      "text-color": "#FF9F1C",
      "selected-text-color": "#F2F2F7",
      "bold": true
    },
    "Comment": {
      "text-color": "#8A8AA6",
      "selected-text-color": "#F2F2F7",
      "italic": true
    },
    "Documentation": {
      "text-color": "#B08AC0",
      "selected-text-color": "#F2F2F7",
      "italic": true
    },
    "Annotation": {
      "text-color": "#8B5CFF",
      "selected-text-color": "#F2F2F7"
    },
    "CommentVar": {
      "text-color": "#FF4D94",
