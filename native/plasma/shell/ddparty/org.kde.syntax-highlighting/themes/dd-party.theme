    "MarkBreakpointReached": "#FFE14D",
    "MarkBreakpointDisabled": "#8B5CFF",
    "MarkExecution": "#3DFF8B",
    "MarkWarning": "#FF9F1C",
    "MarkError": "#FF3B5C",
    "ModifiedLines": "#FF9F1C",
    "SavedLines": "#3DFF8B",
    "ReplaceHighlight": "#1F5A3A",
    "SearchHighlight": "#5A4A10",
    "TextSelection": "#990045",
    "Separator": "#2A2A3D",
    "SpellChecking": "#FF3B5C",
    "TabMarker": "#2A2A3D",
    "TemplateBackground": "#12121E",
    "TemplatePlaceholder": "#1A0F22",
    "TemplateFocusedPlaceholder": "#3A1028",
    "TemplateReadOnlyPlaceholder": "#12121E",
    "WordWrapMarker": "#22223A"
  }
