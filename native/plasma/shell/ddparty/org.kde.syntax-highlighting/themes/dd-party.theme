    },
    "RegionMarker": {
      "text-color": "#2EC5FF",
      "selected-text-color": "#F2F2F7",
      "background-color": "#14142A"
    },
    "Information": {
      "text-color": "#2EC5FF",
      "selected-text-color": "#F2F2F7"
    },
    "Warning": {
      "text-color": "#FF9F1C",
      "selected-text-color": "#F2F2F7"
    },
    "Alert": {
      "text-color": "#FF3B5C",
      "selected-text-color": "#F2F2F7",
      "bold": true,
      "background-color": "#2A0F18"
    },
    "Others": {
      "text-color": "#3DFF8B",
      "selected-text-color": "#F2F2F7"
    },
    "Error": {
      "text-color": "#FF3B5C",
      "selected-text-color": "#F2F2F7",
      "underline": true
    }
