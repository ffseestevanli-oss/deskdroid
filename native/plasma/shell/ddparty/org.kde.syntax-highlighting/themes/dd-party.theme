      "selected-text-color": "#F2F2F7",
      "bold": true
    },
    "Function": {
      "text-color": "#2EC5FF",
      "selected-text-color": "#F2F2F7"
    },
    "Variable": {
      "text-color": "#FF8FB8",
      "selected-text-color": "#F2F2F7"
    },
    "ControlFlow": {
      "text-color": "#FF4FD8",
      "selected-text-color": "#F2F2F7",
      "bold": true
    },
    "Operator": {
      "text-color": "#C9C9DC",
      "selected-text-color": "#F2F2F7"
    },
    "BuiltIn": {
      "text-color": "#8B5CFF",
      "selected-text-color": "#F2F2F7"
    },
    "Extension": {
      "text-color": "#2EC5FF",
      "selected-text-color": "#F2F2F7",
      "bold": true
    },
    "Preprocessor": {
      "text-color": "#FF9F1C",
      "selected-text-color": "#F2F2F7"
    },
    "Attribute": {
