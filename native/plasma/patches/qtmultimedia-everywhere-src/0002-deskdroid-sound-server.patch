--- a/src/multimedia/platform/qplatformaudiodevices.cpp
+++ b/src/multimedia/platform/qplatformaudiodevices.cpp
@@ -9,6 +9,10 @@
 
 #if defined(Q_OS_ANDROID)
 #include <qandroidaudiodevices_p.h>
+#if QT_CONFIG(pulseaudio)
+#include <qpulseaudiodevices_p.h>
+#include <QtCore/qfileinfo.h>
+#endif
 #elif defined(Q_OS_DARWIN)
 #include <qdarwinaudiodevices_p.h>
 #elif defined(Q_OS_WINDOWS) && QT_CONFIG(wmf)
@@ -32,6 +36,16 @@
 #elif defined(Q_OS_WINDOWS) && QT_CONFIG(wmf)
     return std::make_unique<QWindowsAudioDevices>();
 #elif defined(Q_OS_ANDROID)
+#if QT_CONFIG(pulseaudio)
+    // DeskDroid: on the desktop, play into its sound server (PULSE_SERVER,
+    // native/sound) like Linux programs, so EasyEffects and the server's
+    // mixing apply; Android's own output when there's none, or with
+    // DESKDROID_ANDROID_AUDIO=1.
+    const QString server = qEnvironmentVariable("PULSE_SERVER");
+    if (server.startsWith(QLatin1String("unix:")) && !qEnvironmentVariableIsSet("DESKDROID_ANDROID_AUDIO")
+        && QFileInfo::exists(server.mid(5)))
+        return std::make_unique<QPulseAudioDevices>();
+#endif
     return std::make_unique<QAndroidAudioDevices>();
 #elif QT_CONFIG(alsa)
     return std::make_unique<QAlsaAudioDevices>();
