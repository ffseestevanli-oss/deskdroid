+// DeskDroid: Android only execs files from the APK and the system, so FEX
+// and the programs it starts run through ddmask (preloaded into FEX), which
+// wraps the C library's exec calls: exec through execveat(), not the raw
+// system call. FEX starts itself again by its real path, which ddmask gives
+// readlink("/proc/self/exe"); /proc/self/exe is the loader FEX runs under.
+static int DeskDroidExecveat(int dirfd, const char* path, char* const* argv, char* const* envp, int flags) {
+  if (strcmp(path, "/proc/self/exe") == 0) {
+    static char Self[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", Self, sizeof(Self) - 1);
+    if (n > 0) {
+      Self[n] = 0;
+      path = Self;
+    }
+  }
+  return ::execveat(dirfd, path, argv, envp, flags);
+}
