+// DeskDroid: the desktop's LD_PRELOAD (ddmask) and LD_LIBRARY_PATH (the
+// APK's library folder) hold Android libraries. FEX itself doesn't read them
+// (DeskDroid's glibc has its own variables), but x86 programs would: their
+// loader complains about each one. Drop them when they're only Android's.
+static bool DeskDroidOnlyAndroid(const char* List, bool Preload) {
+  if (!List || !*List) return false;
+  std::string_view L {List};
+  while (!L.empty()) {
+    auto End = L.find_first_of(Preload ? ": " : ":");
+    auto Item = L.substr(0, End);
+    if (!Item.empty() && !(Preload ? Item.find("libddmask") != std::string_view::npos : Item.starts_with("/data/app/"))) {
+      return false;
+    }
+    if (End == std::string_view::npos) break;
+    L.remove_prefix(End + 1);
+  }
+  return true;
+}
+
+static void DeskDroidCleanEnvironment() {
+  if (DeskDroidOnlyAndroid(getenv("LD_PRELOAD"), true)) {
+    unsetenv("LD_PRELOAD");
+  }
+  if (DeskDroidOnlyAndroid(getenv("LD_LIBRARY_PATH"), false)) {
+    unsetenv("LD_LIBRARY_PATH");
+  }
+}
